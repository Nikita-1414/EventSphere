# ========== FRONTEND CONFIGURATION ==========

# API Base URL - Backend endpoint
# Production: Your Render backend URL
# Local Dev: http://localhost:5000/api
VITE_API_BASE_URL=https://eventsphere-backend.onrender.com/api

# App Name
VITE_APP_NAME=EventSphere

# ========== DEVELOPMENT ENVIRONMENT ==========
# For local development, create .env.local with:
# VITE_API_BASE_URL=http://localhost:5000/api
# VITE_APP_NAME=EventSphere (local)

# ========== NOTES ==========
# - Vite exposes only variables prefixed with VITE_
# - Variables are baked into the build at build time
# - Use import.meta.env.VITE_* to access them in React
# - Example: import.meta.env.VITE_API_BASE_URL
