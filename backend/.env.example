# ========== DEPLOYMENT ENVIRONMENT ==========
NODE_ENV=production

# ========== SERVER ==========
PORT=10000
# Render will assign this automatically; keep 10000 for local dev

# ========== DATABASE ==========
# MongoDB Atlas Connection String
# Get this from: https://www.mongodb.com/cloud/atlas
# Format: mongodb+srv://username:password@cluster.mongodb.net/database_name
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@cluster.mongodb.net/eventora

# ========== AUTHENTICATION ==========
# Generate a strong secret: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your_jwt_secret_key_here_min_32_chars_or_longer

# ========== EMAIL SERVICE ==========
# Gmail: Use App Password (not regular password)
# Get App Password from: https://myaccount.google.com/apppasswords
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_app_specific_password

# ========== FRONTEND URL (for CORS) ==========
# This will be your Vercel frontend URL
FRONTEND_URL=https://eventsphere.vercel.app

# ========== RENDER SPECIFIC (optional) ==========
# Render sets these automatically in most cases
# RENDER=true
# RENDER_GIT_REPO=your_repo_url
